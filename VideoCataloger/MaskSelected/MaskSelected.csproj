<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="mask_selected.cs" />
  </ItemGroup>
  <!-- Compiles against the real application assemblies for full IntelliSense.
       First path is the installed layout (this solution lives in <install dir>\scripts),
       the fallback is the repository installer staging folder. -->
  <ItemGroup>
    <Reference Include="VideoCataloger">
      <HintPath Condition="Exists('..\..\VideoCataloger.dll')">..\..\VideoCataloger.dll</HintPath>
      <HintPath Condition="!Exists('..\..\VideoCataloger.dll')">..\..\net10.0-windows\VideoCataloger.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VideoCatalogService">
      <HintPath Condition="Exists('..\..\VideoCatalogService.dll')">..\..\VideoCatalogService.dll</HintPath>
      <HintPath Condition="!Exists('..\..\VideoCatalogService.dll')">..\..\net10.0-windows\VideoCatalogService.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
